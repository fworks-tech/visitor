[internationalization]

; NOTE: translations are wired at runtime from locale/*.json by
; SettingsManager.load_locale_files() — the Godot CSV importer
; produced an unusable Translation with the empty pt_BR column,
; so no locale/translations remap is configured here.
[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
